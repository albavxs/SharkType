    "next": "16.3.0-canary.52",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.182.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0-canary.52",
    "postcss": "^8.5.15",
    "tailwindcss": "^4",
    "typescript": "^5"
