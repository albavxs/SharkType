{
  "name": "sharktype",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "npm": ">=10",
    "node": "22.x"
  },
  "scripts": {
    "check:pt-content": "node scripts/check-pt-content.mjs",
    "check:access-policies": "node scripts/check-access-policies.mjs",
    "check:mastery-separation": "node scripts/check-mastery-separation.mjs",
    "check:themes": "node scripts/check-theme-colors.mjs",
    "dev": "next dev --webpack",
