# Copy this file to .env.local for local development.
# In Vercel, add the same values in the project Environment Variables screen
# and redeploy after every NEXT_PUBLIC_* change.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Legacy fallback still supported by SharkType for older deployments.
# Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new setups.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

NEXT_PUBLIC_SITE_URL=https://shark-type-io.vercel.app/

# Private premium snippets package. Keep this package/repo private.
# It may export getPremiumSnippets(languageId) or premiumSnippetRegistry.
SHARKTYPE_PREMIUM_CONTENT_MODULE=@sharktype/premium-content

# Server-only Supabase key for trusted webhooks and billing reconciliation.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Asaas Plus checkout/webhook integration.
ASAAS_PLUS_CHECKOUT_URL=https://www.asaas.com/c/your-plus-checkout
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token

# Optional: comma-separated host allowlist for accessing Next dev resources
# from other devices on your local network.
# Example: NEXT_ALLOWED_DEV_ORIGINS=192.168.15.*,192.168.0.*
